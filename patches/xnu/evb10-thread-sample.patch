+#if DEVELOPMENT || DEBUG
+/*
+ * EVB10: where the threads of a task are (evb10-ps=N, patches/tools/evb10-userland-mounts.c.inc).
+ *
+ * A launchd that has made 20 system calls in 200 seconds and still burns 57 % of a CPU in the kernel
+ * (xnu-probe/runs/emmc5f) cannot be explained by its counters. This says what each thread is doing:
+ * its scheduling state, what it waits for, the registers it returns to in user mode (the last trap
+ * from user mode: the PC of the system call, the fault address of the abort), and the kernel frames
+ * it is switched out in. It only reads. A thread that runs on another CPU right now has the kernel
+ * stack of its LAST switch-out (its state says so: TH_RUN without TH_WAIT), which still tells where
+ * it keeps coming back to.
+ *
+ * Lives in bsd_kern.c because struct thread, struct task and the per-CPU data are private to osfmk.
+ */
+#if defined(__arm64__)
+#include <arm/cpu_data_internal.h>
+#endif
+#include <vm/vm_shared_region.h>
+extern int printf(const char *, ...) __attribute__((format(printf, 1, 2)));
+extern int machine_trace_thread64(thread_t thread, char *tracepos, char *tracebound, int nframes, uint32_t *thread_trace_flags);
+extern struct arm_saved_state *get_user_regs(thread_t thread);
+extern int ml_get_max_cpu_number(void);
+
+#define EVB10_SAMPLE_FRAMES 14
+#define EVB10_SAMPLE_THREADS 8
+#define EVB10_UBT_THREADS 24
+#define EVB10_UBT_FRAMES 14
+
+extern char *proc_name_address(void *p);
+extern int evb10_shared_region(task_t task, uint64_t out[3]);
+#include <pexpert/pexpert.h>
+
+/*
+ * evb10-bt=<process name> (and evb10-bt2/3/4): at every table (sample 0) print, for each thread of that process, the frame-pointer chain of its
+ * USER stack: where backboardd (or whoever) sits when it has stopped making progress. The addresses are shared cache addresses
+ * after this boot's slide (xnu-probe/symbolize/README.md: dsc.py sym --slide); the second line says the slide.
+ * vm_map_read_user switches to the target's map for the copyin, so a thread of another process is read the same way.
+ */
+#define EVB10_UBT_NAMES 4
+static int evb10_bt_state; /* 0 not read yet, 1 none, 2 at least one name */
+static char evb10_bt_names[EVB10_UBT_NAMES][17];
+
+static const char *
+evb10_bt_wanted(task_t task)
+{
+	void *bsd;
+	int i;
+
+	if (evb10_bt_state == 0) {
+		static const char *const keys[EVB10_UBT_NAMES] = {"evb10-bt", "evb10-bt2", "evb10-bt3", "evb10-bt4"};
+
+		evb10_bt_state = 1;
+		for (i = 0; i < EVB10_UBT_NAMES; i++) {
+			if (PE_parse_boot_argn(keys[i], evb10_bt_names[i], sizeof(evb10_bt_names[i]))) {
+				evb10_bt_state = 2;
+			}
+		}
+	}
+	if (evb10_bt_state != 2) {
+		return NULL;
+	}
+	bsd = get_bsdtask_info(task);
+	if (bsd == NULL) {
+		return NULL;
+	}
+	for (i = 0; i < EVB10_UBT_NAMES; i++) {
+		if (evb10_bt_names[i][0] != 0 && strncmp(proc_name_address(bsd), evb10_bt_names[i], 16) == 0) {
+			return evb10_bt_names[i];
+		}
+	}
+	return NULL;
+}
+
+static void
+evb10_user_chain(task_t task, thread_t thread, struct arm_saved_state *user)
+{
+	uint64_t fp = get_saved_state_fp(user), chain[EVB10_UBT_FRAMES];
+	int n = 0, i;
+
+	while (n < EVB10_UBT_FRAMES && fp != 0 && (fp & 7) == 0) {
+		uint64_t frame[2];
+
+		if (vm_map_read_user(task->map, (vm_map_offset_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+			break;
+		}
+		chain[n++] = frame[1];
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("evb10: ubt tid %#llx pc %#llx lr %#llx sp %#llx fp %#llx | up", thread->thread_id,
+	    (unsigned long long)get_saved_state_pc(user), (unsigned long long)get_saved_state_lr(user),
+	    (unsigned long long)get_saved_state_sp(user), (unsigned long long)get_saved_state_fp(user));
+	for (i = 0; i < n; i++) {
+		printf(" %#llx", chain[i]);
+	}
+	printf("\n");
+}
+
+void evb10_task_threads_dump(task_t task, int sample);
+void evb10_cpu_stats_dump(void);
+
+static boolean_t
+evb10_kbt_wanted(void)
+{
+	static int kbt = -1;
+
+	if (kbt < 0) {
+		uint32_t v = 0;
+
+		(void) PE_parse_boot_argn("evb10-kbt", &v, sizeof(v));
+		kbt = v ? 1 : 0;
+	}
+	return kbt == 1;
+}
+
+void
+evb10_task_threads_dump(task_t task, int sample)
+{
+	thread_t thread;
+	int shown = 0;
+	boolean_t want_bt = FALSE;
+	int limit = EVB10_SAMPLE_THREADS;
+	uint64_t cache[3] = {0, 0, 0};
+	const char *bt_name;
+
+	if (task == TASK_NULL) {
+		return;
+	}
+	if (sample == 0 && (bt_name = evb10_bt_wanted(task)) != NULL) {
+		want_bt = TRUE;
+		limit = EVB10_UBT_THREADS;
+		if (evb10_shared_region(task, cache) == 0) {
+			printf("evb10: ubt %s: cache base %#llx first %#llx slide %#llx\n", bt_name, (unsigned long long)cache[0],
+			    (unsigned long long)cache[1], (unsigned long long)cache[2]);
+		}
+	}
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		uint64_t frames[EVB10_SAMPLE_FRAMES] = {0};
+		uint32_t flags = 0;
+		int count, i;
+		uint64_t pc = 0, lr = 0, sp = 0, x0 = 0, x1 = 0, x16 = 0, far = 0;
+		uint32_t esr = 0;
+		struct arm_saved_state *user;
+
+		if (++shown > limit) {
+			break;
+		}
+		/*
+		 * A thread that blocked with a continuation has no kernel stack at all (machine_stack_detach
+		 * clears kstackptr), and machine_trace_thread64 walks it unchecked: the first MSUEarlyBootTask
+		 * that sat in such a wait took the whole kernel down with a data abort at 0x3f98
+		 * (xnu-probe/runs/emmc5i). Its continuation says where it will resume instead.
+		 */
+		count = 0;
+		/*
+		 * The check races with the thread blocking on a continuation (it detaches its stack at that moment, no lock of ours keeps it from
+		 * it): a process that is killed and started again every few seconds (a poster extension whose check-in times out) took the kernel
+		 * down with the same data abort at 0x3f98 (xnu-probe/runs/gpu52). So the kernel frames are opt-in, boot-arg evb10-kbt=1.
+		 */
+		if (evb10_kbt_wanted() && (thread == current_thread() || thread->machine.kstackptr != NULL)) {
+			count = machine_trace_thread64(thread, (char *)frames, (char *)(frames + EVB10_SAMPLE_FRAMES), EVB10_SAMPLE_FRAMES,
+			    &flags) / (int)sizeof(frames[0]);
+		}
+		user = get_user_regs(thread);
+		if (user != NULL) {
+			pc = get_saved_state_pc(user);
+			lr = get_saved_state_lr(user);
+			sp = get_saved_state_sp(user);
+			x0 = get_saved_state_reg(user, 0);
+			x1 = get_saved_state_reg(user, 1);
+			x16 = get_saved_state_reg(user, 16);
+			esr = get_saved_state_esr(user);
+			far = get_saved_state_far(user);
+		}
+		printf("evb10: thr %d tid %#llx st %#x pri %d/%d sw %u/%u cpu %d wait %d ev %#llx | user pc %#llx lr %#llx sp %#llx x0 %#llx "
+		    "x1 %#llx x16 %#llx esr %#x far %#llx | cont %#llx kern%s",
+		    sample, thread->thread_id, (unsigned)thread->state, (int)thread->sched_pri, (int)thread->base_pri,
+		    thread->c_switch, thread->p_switch, thread->last_processor ? thread->last_processor->cpu_id : -1,
+		    (int)thread->wait_result, (unsigned long long)thread->wait_event, pc, lr, sp, x0, x1, x16, esr, far,
+		    (unsigned long long)(uintptr_t)thread->continuation, flags ? "(trunc)" : "");
+		for (i = 0; i < count; i++) {
+			printf(" %#llx", frames[i]);
+		}
+		printf("\n");
+		if (want_bt && user != NULL) {
+			evb10_user_chain(task, thread, user);
+		}
+	}
+	task_unlock(task);
+}
+
+/*
+ * The registers a thread had at its last trap from user mode, for the crash-site dump of bsd
+ * (evb10_exit_trace): pc, lr, sp, fp, x0, x1, x2, x16, esr, far. 0 if the thread has user state.
+ */
+int evb10_user_context(thread_t thread, uint64_t out[10]);
+
+int
+evb10_user_context(thread_t thread, uint64_t out[10])
+{
+	struct arm_saved_state *user = get_user_regs(thread);
+
+	if (user == NULL) {
+		return -1;
+	}
+	out[0] = get_saved_state_pc(user);
+	out[1] = get_saved_state_lr(user);
+	out[2] = get_saved_state_sp(user);
+	out[3] = get_saved_state_fp(user);
+	out[4] = get_saved_state_reg(user, 0);
+	out[5] = get_saved_state_reg(user, 1);
+	out[6] = get_saved_state_reg(user, 2);
+	out[7] = get_saved_state_reg(user, 16);
+	out[8] = get_saved_state_esr(user);
+	out[9] = get_saved_state_far(user);
+	return 0;
+}
+
+/*
+ * Where the task's shared cache is: its base, the offset of the first mapping and the random slide of
+ * this boot (a cache address in a crash dump minus the slide is the address in the file, so the dump
+ * can be matched to the unslid cache). out[0] = base, out[1] = first mapping, out[2] = slide.
+ */
+int evb10_shared_region(task_t task, uint64_t out[3]);
+
+int
+evb10_shared_region(task_t task, uint64_t out[3])
+{
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr == NULL) {
+		return -1;
+	}
+	out[0] = sr->sr_base_address;
+	out[1] = sr->sr_first_mapping;
+	out[2] = sr->sr_slide;
+	vm_shared_region_deallocate(sr);
+	return 0;
+}
