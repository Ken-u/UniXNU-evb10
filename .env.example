# Copy to .env (ignored by git). scripts/build-evb10-kernel.sh reads it.
# UniXNU checkout that runs the build (Python 3.11 or newer; on Linux the checkout carries the toolchain setup).
UNIXNU=$HOME/UniXNU
# Prefix for the UniXNU commands, for example a user-namespace wrapper on a machine without root. Empty by default.
UNIXNU_WRAP=
# llvm-objcopy that can delete Mach-O sections (the display archive step needs one).
UNIXNU_LLVM_OBJCOPY=
# Directory that holds the Mali firmware for scripts/extract-files.py (see proprietary-files.txt).
MALI_FIRMWARE_DIR=
JOBS=8
